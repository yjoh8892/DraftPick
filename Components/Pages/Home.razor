@page "/"
@inject DraftRoomStore Store
@inject NavigationManager Nav

<PageTitle>DraftPick — 내전 드래프트 진행</PageTitle>

<div class="landing">
    <div class="landing-hero">
        <h1>내전 드래프트를 <span class="accent">한 화면</span>에서</h1>
        <p>
            진행자가 방을 만들고 코드를 알려주면, 팀장들이 각자 브라우저로 들어와 자기 차례에 선수를 지명합니다.
            누가 뽑혔는지·다음이 누구 차례인지·남은 시간이 전원에게 실시간으로 똑같이 보입니다.
        </p>
    </div>

    <div class="landing-cards">
        <section class="card">
            <h2>방 만들기</h2>
            <p class="muted">진행자용. 팀과 선수 명단을 등록하고 드래프트를 진행합니다.</p>
            <button class="btn btn-primary btn-lg" @onclick="CreateRoom">새 드래프트 방 만들기</button>
        </section>

        <section class="card">
            <h2>방 참가</h2>
            <p class="muted">팀장·관전자용. 진행자에게 받은 5자리 코드를 입력하세요.</p>
            <div class="join-form">
                <input class="input code-input" maxlength="5" placeholder="ABC12" autocomplete="off"
                       @bind="_code" @bind:event="oninput" @onkeydown="OnCodeKeyDown" />
                <button class="btn btn-lg" @onclick="JoinRoom" disabled="@(_code.Trim().Length == 0)">입장</button>
            </div>
            @if (_error is not null)
            {
                <p class="error-text">@_error</p>
            }
        </section>
    </div>

    <section class="landing-how">
        <h3>진행 방식</h3>
        <ol>
            <li><b>설정</b> — 팀(팀장)과 선수 명단을 등록하고 지명 방식·라운드 수·턴 제한시간을 정합니다.</li>
            <li><b>입장</b> — 팀장들이 코드로 들어와 자기 팀을 고릅니다. 관전자는 보기만 합니다.</li>
            <li><b>지명</b> — 자기 차례에만 선수 카드를 누를 수 있습니다. 시간이 다 되면 자동 지명(설정 가능).</li>
            <li><b>결과</b> — 팀별 로스터를 텍스트로 복사해 디스코드에 그대로 붙여넣습니다.</li>
        </ol>
    </section>
</div>

@code {
    private string _code = "";
    private string? _error;

    private void CreateRoom()
    {
        var room = Store.Create();
        Nav.NavigateTo($"/room/{room.Code}?host={room.HostKey}");
    }

    private void OnCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") JoinRoom();
    }

    private void JoinRoom()
    {
        var code = _code.Trim();
        if (code.Length == 0) return;

        if (Store.Find(code) is null)
        {
            _error = $"'{code}' 방을 찾을 수 없습니다. 코드를 다시 확인해주세요.";
            return;
        }
        Nav.NavigateTo($"/room/{code}");
    }
}
