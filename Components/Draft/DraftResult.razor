@* 드래프트 완료 화면. 디스코드에 그대로 붙여넣을 수 있게 텍스트로 뽑아준다. *@

@{
    var rosters = Room.RostersByTeam();
    var teamsById = Room.Teams.ToDictionary(t => t.Id);
    var undrafted = Room.AvailablePlayers.ToList();
}

<div class="result">
    <div class="card result-head">
        <div>
            <h2>드래프트 완료</h2>
            <p class="muted">
                @(Room.Teams.Count)개 팀 · @(Room.Rounds)라운드 ·
                @Room.OrderMode.Label() 방식으로 총 @(Room.TotalPicks)번의 지명이 끝났습니다.
            </p>
        </div>
        <div class="row-actions">
            <CopyButton Text="BuildText" Label="결과 텍스트 복사" Class="btn-primary" />
            @if (IsHost)
            {
                <button class="btn" @onclick="Room.ResetToSetup">설정으로 돌아가기</button>
                <button class="btn btn-ghost" @onclick="Undo">마지막 픽 되돌리기</button>
            }
        </div>
    </div>

    <div class="result-rosters">
        @foreach (var team in Room.Teams)
        {
            <section class="card roster" style="--team-color:@team.Color" @key="team.Id">
                <div class="roster-head">
                    <span class="team-dot"></span>
                    <span class="team-name">@team.Name</span>
                    @if (!string.IsNullOrWhiteSpace(team.Captain))
                    {
                        <span class="team-captain">@team.Captain</span>
                    }
                </div>
                <ol class="roster-list">
                    @foreach (var player in rosters[team.Id])
                    {
                        <li class="roster-slot">
                            <span class="slot-pick">#@player.PickNumber</span>
                            <span class="slot-name">@player.Name</span>
                            <PlayerTags Player="player" />
                        </li>
                    }
                </ol>
            </section>
        }
    </div>

    <section class="card">
        <h3>지명 순서 전체 기록</h3>
        <ol class="pick-log">
            @foreach (var player in Room.Players.Where(p => p.IsDrafted).OrderBy(p => p.PickNumber))
            {
                var team = teamsById.GetValueOrDefault(player.DraftedBy!.Value);
                <li style="--team-color:@(team?.Color ?? TeamColors.Neutral)">
                    <span class="slot-pick">#@player.PickNumber</span>
                    <span class="team-dot"></span>
                    <span class="log-team">@(team?.Name ?? "?")</span>
                    <span class="log-arrow">→</span>
                    <span class="slot-name">@player.Name</span>
                    <PlayerTags Player="player" ShowTier="false" />
                </li>
            }
        </ol>
    </section>

    @if (undrafted.Count > 0)
    {
        <section class="card">
            <h3>미지명 선수 <span class="count">@undrafted.Count</span></h3>
            <div class="chip-wrap">
                @foreach (var player in undrafted)
                {
                    <span class="chip">@player.Name</span>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public required DraftRoom Room { get; set; }
    [Parameter] public bool IsHost { get; set; }

    private void Undo() => Room.UndoLastPick();

    private string BuildText()
    {
        var lines = new List<string>
        {
            $"[{Room.Title}] {Room.OrderMode.Label()} · {Room.Rounds}라운드",
            "",
        };

        foreach (var team in Room.Teams)
        {
            var header = string.IsNullOrWhiteSpace(team.Captain) ? team.Name : $"{team.Name} ({team.Captain})";
            lines.Add($"■ {header}");

            foreach (var player in Room.RosterOf(team.Id))
            {
                var position = player.Position == Positions.Unset ? "" : $" [{player.Position}]";
                lines.Add($"  {player.PickNumber}. {player.Name}{position}");
            }
            lines.Add("");
        }

        return string.Join("\n", lines).TrimEnd();
    }
}
