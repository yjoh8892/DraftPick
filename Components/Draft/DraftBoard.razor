@implements IAsyncDisposable
@inject IJSRuntime JS

@* 진행 중 화면. 서버가 1초마다 방을 두드리므로 타이머와 지명 결과가 모두에게 동시에 반영된다. *@

@{
    // 이 화면은 초당 한 번 통째로 다시 그려진다. 아래 값들은 그때마다 한 번씩만 계산한다.
    var onClock = Room.CurrentTeam;
    var available = Room.AvailablePlayers.ToList();
    var pool = Filter(available);
    var rosters = Room.RostersByTeam();
}

<div class="board">
    @if (Room.LastEvent is { } happened)
    {
        @* @key가 사건마다 달라져서 요소가 새로 만들어지고, 그때마다 CSS 애니메이션이 처음부터 돈다. *@
        <div class="pick-toast @ToastClass(happened.Kind)" style="--team-color:@happened.TeamColor" @key="happened">
            <span class="toast-pick">#@happened.PickNumber</span>
            <span class="team-dot"></span>
            <span class="toast-team">@happened.TeamName</span>
            @if (happened.PlayerName.Length > 0)
            {
                <span class="toast-arrow">@(happened.Kind == DraftEventKind.Undo ? "✕" : "→")</span>
                <span class="toast-player">@happened.PlayerName</span>
            }
            <span class="toast-kind">@ToastLabel(happened.Kind)</span>
        </div>
    }

    <section class="turn-bar @(IsMyTurn ? "my-turn" : "")" style="--team-color:@(onClock?.Color ?? TeamColors.Neutral)">
        <div class="turn-meta">
            <span class="turn-round">R@(Room.CurrentRound) / @Room.Rounds</span>
            <span class="turn-pick">@(Room.PickIndex + 1)번째 픽 · 전체 @Room.TotalPicks</span>
        </div>

        <div class="turn-who">
            <span class="turn-dot"></span>
            <span class="turn-team">@(onClock?.Name ?? "—")</span>
            @if (!string.IsNullOrWhiteSpace(onClock?.Captain))
            {
                <span class="turn-captain">@onClock!.Captain</span>
            }
            @if (IsMyTurn)
            {
                <span class="badge badge-live">내 차례</span>
            }
        </div>

        <div class="turn-clock">
            @if (Room.Status == RoomStatus.Paused)
            {
                <span class="clock paused">일시정지</span>
            }
            else if (Room.AwaitingHostAfterTimeout)
            {
                <span class="clock unlimited">시간 종료</span>
            }
            else if (Room.SecondsLeft is { } left)
            {
                <span class="clock @(left <= 10 ? "urgent" : "")">@left</span>
                <div class="clock-bar"><div class="clock-fill" style="width:@ClockPercent%"></div></div>
            }
            else
            {
                <span class="clock unlimited">무제한</span>
            }
        </div>

        @if (IsHost)
        {
            <div class="host-controls">
                @if (Room.Status == RoomStatus.Running)
                {
                    <button class="btn btn-sm" @onclick="Room.Pause">일시정지</button>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="Room.Resume">재개</button>
                }
                <button class="btn btn-sm" @onclick="Undo" disabled="@(!Room.CanUndo)">되돌리기</button>
                <button class="btn btn-sm" @onclick="Room.SkipTurn" disabled="@(Room.Status != RoomStatus.Running)">턴 넘기기</button>
            </div>
        }
    </section>

    @if (_error is not null)
    {
        <p class="error-text board-error">@_error</p>
    }

    <div class="board-grid">
        <section class="card pool">
            <div class="card-head">
                <h3>남은 선수 <span class="count">@available.Count</span></h3>
                <input class="input search" placeholder="이름 검색" @bind="_search" @bind:event="oninput" />
            </div>

            <div class="filter-row">
                <button class="filter @(_position is null ? "on" : "")" @onclick="() => _position = null">전체</button>
                @foreach (var pos in Positions.All)
                {
                    <button class="filter @(_position == pos ? "on" : "")" @onclick="() => _position = pos">@pos</button>
                }
            </div>

            <div class="player-grid">
                @foreach (var player in pool)
                {
                    <button class="player-card tile @(CanPick ? "pickable" : "")" @key="player.Id"
                            disabled="@(!CanPick)" @onclick="() => Pick(player.Id)">
                        <span class="player-name">@player.Name</span>
                        <span class="player-meta"><PlayerTags Player="player" /></span>
                    </button>
                }
                @if (pool.Count == 0)
                {
                    <p class="muted">조건에 맞는 선수가 없습니다.</p>
                }
            </div>
        </section>

        <section class="rosters">
            @foreach (var team in Room.Teams)
            {
                var roster = rosters[team.Id];
                <div class="roster @(team.Id == onClock?.Id ? "on-clock" : "") @(team.Id == MyTeamId ? "mine" : "")"
                     style="--team-color:@team.Color" @key="team.Id">
                    <div class="roster-head">
                        <SeatLight Connected="Room.IsTeamConnected(team.Id)" />
                        <span class="team-dot"></span>
                        <span class="team-name">@team.Name</span>
                        <span class="roster-count" title="지명한 인원 / 지명 가능 인원">@roster.Count / @Room.Rounds</span>
                    </div>
                    <ol class="roster-list">
                        @* 팀장은 지명 대상이 아니라 뽑는 쪽이라 명단에 없다. 팀 구성이 한눈에 들어오도록 여기 고정해둔다. *@
                        @if (!string.IsNullOrWhiteSpace(team.Captain))
                        {
                            <li class="roster-slot captain">
                                <span class="slot-badge">팀장</span>
                                <span class="slot-name">@team.Captain</span>
                            </li>
                        }
                        @for (var slot = 0; slot < Room.Rounds; slot++)
                        {
                            var picked = slot < roster.Count ? roster[slot] : null;
                            <li class="roster-slot @(picked is null ? "empty" : "")">
                                @if (picked is not null)
                                {
                                    <span class="slot-pick">#@picked.PickNumber</span>
                                    <span class="slot-name">@picked.Name</span>
                                    <PlayerTags Player="picked" ShowTier="false" />
                                }
                                else
                                {
                                    <span class="slot-empty">—</span>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
        </section>
    </div>

    <section class="upcoming">
        <span class="upcoming-label">다음 순서</span>
        @foreach (var (number, team) in Room.UpcomingPicks(8))
        {
            <span class="upcoming-item @(number == Room.PickIndex + 1 ? "now" : "")" style="--team-color:@team.Color">
                <span class="team-dot"></span>#@number @team.Name
            </span>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public required DraftRoom Room { get; set; }
    [Parameter] public Guid? MyTeamId { get; set; }

    /// <summary>진행자 키. 진행자인지 판단하는 건 방이 하고, 화면은 키만 전달한다.</summary>
    [Parameter] public string? HostKey { get; set; }

    private string _search = "";
    private string? _position;
    private string? _error;

    private bool IsHost => Room.IsHost(HostKey);

    private bool IsMyTurn => MyTeamId is { } id && Room.CurrentTeam?.Id == id;

    /// <summary>규칙은 방이 정한다. 화면은 같은 판단을 다시 구현하지 않는다.</summary>
    private bool CanPick => Room.CanPick(MyTeamId ?? Guid.Empty, HostKey);

    private int ClockPercent =>
        Room.TurnSeconds > 0 && Room.SecondsLeft is { } left
            ? Math.Clamp(left * 100 / Room.TurnSeconds, 0, 100)
            : 0;

    private List<Player> Filter(List<Player> available) =>
        available
            .Where(p => _position is null || p.Position == _position)
            .Where(p => _search.Length == 0 || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private static string ToastLabel(DraftEventKind kind) => kind switch
    {
        DraftEventKind.Pick => "지명",
        DraftEventKind.AutoPick => "시간 초과 · 자동 지명",
        DraftEventKind.Skip => "턴 넘김",
        DraftEventKind.Undo => "지명 취소",
        _ => "",
    };

    private static string ToastClass(DraftEventKind kind) => kind switch
    {
        DraftEventKind.AutoPick => "auto",
        DraftEventKind.Skip => "skip",
        DraftEventKind.Undo => "undo",
        _ => "",
    };

    private void Pick(Guid playerId) => _error = Room.Pick(playerId, MyTeamId ?? Guid.Empty, HostKey);

    private void Undo() => _error = Room.UndoLastPick();

    // ── 내 차례 알림 ─────────────────────────────────────────────────────
    // 디스코드를 보다가 탭을 놓치면 자동 지명으로 넘어가 버린다. 차례가 시작될 때 한 번만 알린다.

    private bool _alerting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldAlert = IsMyTurn && Room.Status == RoomStatus.Running;
        if (shouldAlert == _alerting) return;

        _alerting = shouldAlert;
        await CallAlert(shouldAlert ? "alertTurn" : "clearAlert");
    }

    public async ValueTask DisposeAsync()
    {
        // 드래프트가 끝나 이 화면이 사라질 때 제목이 계속 깜빡이지 않도록 정리한다.
        if (_alerting) await CallAlert("clearAlert");
    }

    private async Task CallAlert(string method)
    {
        try
        {
            await JS.InvokeVoidAsync($"draftPick.{method}", "🔔 내 차례!");
        }
        catch (JSException)
        {
            // 스크립트가 아직 없거나 브라우저가 막은 경우. 알림이 없을 뿐 진행에는 지장이 없다.
        }
        catch (JSDisconnectedException)
        {
            // 회선이 이미 끊긴 뒤의 정리 호출.
        }
    }
}
