@page "/room/{Code}"
@implements IDisposable
@inject DraftRoomStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_room is null ? "방 없음" : $"{_room.Title} ({_room.Code}) — DraftPick")</PageTitle>

@if (_room is null)
{
    <div class="card center-card">
        <h2>방을 찾을 수 없습니다</h2>
        <p class="muted">
            <b>@Code</b> 코드의 방이 없습니다. 코드를 잘못 입력했거나, 서버가 재시작되어 방이 사라졌을 수 있습니다.
        </p>
        <a class="btn btn-primary" href="/">처음으로</a>
    </div>
}
else
{
<div class="room">
    <div class="room-bar">
        <div class="room-id">
            <span class="room-code" title="방 코드">@_room.Code</span>
            <span class="room-title">@_room.Title</span>
            <span class="badge badge-@StatusClass">@StatusLabel</span>
        </div>

        <div class="room-actions">
            <span class="viewers" title="이 방을 보고 있는 화면 수">👀 @_room.ViewerCount</span>
            <span class="role-badge">@RoleLabel</span>
            @if (_isHost)
            {
                <CopyButton Text="HostLink" Label="진행자 링크 복사" Class="btn-ghost btn-sm" />
            }
            else
            {
                <button class="btn btn-ghost btn-sm" @onclick="ClearRole">역할 변경</button>
            }
            <CopyButton Text="JoinLink" Label="참가 링크 복사" Class="btn-ghost btn-sm" />
            <button class="btn btn-ghost btn-sm" @onclick="() => _chatOpen = !_chatOpen">
                💬 채팅 @(_room.Chat.Count > 0 ? _room.Chat.Count.ToString() : "")
            </button>
        </div>
    </div>

    @if (_chatOpen)
    {
        <ChatPanel Room="_room" Name="_name" MyTeamId="_myTeamId" HostKey="HostKey"
                   OnClose="() => _chatOpen = false"
                   NameChangeRequested="OpenNameEditor" />
    }

    @if (_editingName)
    {
        <div class="card center-card name-dialog">
            <h3>닉네임</h3>
            <p class="muted">채팅에 표시될 이름입니다. 이 브라우저에 기억해둡니다.</p>
            <div class="key-entry">
                <input class="input" placeholder="닉네임" maxlength="@DraftRoom.MaxNameLength" autocomplete="off"
                       @bind="_typedName" @bind:event="oninput" @onkeydown="OnNameKeyDown" />
                <button class="btn btn-primary" @onclick="SaveName"
                        disabled="@(_typedName.Trim().Length == 0)">확인</button>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="() => _editingName = false">취소</button>
        </div>
    }

    @if (_isHost && _room.Status == RoomStatus.Setup && !_guardDismissed)
    {
        <div class="card host-guard">
            <div>
                <h3>진행자 링크를 지금 보관해두세요</h3>
                <p class="muted">
                    이 링크(또는 아래 키)가 진행자 권한의 전부입니다. 잃어버리면 이 방을 조작할 사람이
                    없어져 처음부터 다시 만들어야 합니다. 디스코드에 자신에게 보내두는 것을 권합니다.
                </p>
                <p class="hint">
                    이 브라우저에는 자동으로 저장해뒀습니다. 실수로 탭을 닫아도 같은 브라우저로 방에
                    다시 들어오면 진행자로 돌아올 수 있습니다.
                </p>
            </div>
            <div class="host-guard-key">
                <span class="key-label">진행자 키</span>
                <code class="host-key">@_room.HostKey</code>
                <div class="row-actions">
                    <CopyButton Text="HostLink" Label="링크 복사" Class="btn-primary btn-sm" />
                    <button class="btn btn-ghost btn-sm" @onclick="() => _guardDismissed = true">보관했습니다</button>
                </div>
            </div>
        </div>
    }

    @if (!_isHost && _myTeamId is null && !_spectator)
    {
        <div class="card role-picker">
            <h2>어느 자리로 들어오시나요?</h2>

            @if (_savedHostKey is not null)
            {
                <div class="host-return">
                    <span>이 브라우저에 진행자 권한이 저장되어 있습니다.</span>
                    <button class="btn btn-primary btn-sm" @onclick="() => EnterAsHost(_savedHostKey)">진행자로 입장</button>
                </div>
            }

            @if (_room.Teams.Count == 0)
            {
                <p class="muted">진행자가 아직 팀을 만들지 않았습니다. 팀이 등록되면 여기에 나타납니다.</p>
            }
            else
            {
                <p class="muted">본인 팀을 고르면 자기 차례에 직접 지명할 수 있습니다.</p>
                <div class="team-choice-grid">
                    @foreach (var team in _room.Teams)
                    {
                        <button class="team-choice tile" style="--team-color:@team.Color" @onclick="() => ChooseTeam(team.Id)">
                            <span class="team-choice-name">@team.Name</span>
                            @if (!string.IsNullOrWhiteSpace(team.Captain))
                            {
                                <span class="team-choice-captain">@team.Captain</span>
                            }
                        </button>
                    }
                </div>
            }

            <label class="field nickname-field">
                <span>닉네임 (채팅에 표시됩니다)</span>
                <input class="input" placeholder="예: 길동" maxlength="@DraftRoom.MaxNameLength" autocomplete="off"
                       @bind="_name" @bind:event="oninput" @bind:after="RememberName" />
            </label>

            <div class="row-actions role-picker-actions">
                <button class="btn btn-ghost" @onclick="ChooseSpectator">관전자로 보기</button>
                <button class="btn btn-ghost" @onclick="() => _askingHostKey = !_askingHostKey">진행자 키로 입장</button>
            </div>

            @if (_askingHostKey)
            {
                <div class="key-entry">
                    <input class="input" placeholder="진행자 키" autocomplete="off"
                           @bind="_typedHostKey" @bind:event="oninput" @onkeydown="OnHostKeyDown" />
                    <button class="btn btn-primary" @onclick="() => EnterAsHost(_typedHostKey)"
                            disabled="@(_typedHostKey.Trim().Length == 0)">입장</button>
                </div>
                @if (_hostKeyError is not null)
                {
                    <p class="error-text">@_hostKeyError</p>
                }
            }
        </div>
    }
    else
    {
        @switch (_room.Status)
        {
            case RoomStatus.Setup when _isHost:
                <RoomSetup Room="_room" />
                break;

            case RoomStatus.Setup:
                <WaitingRoom Room="_room" MyTeamId="_myTeamId" />
                break;

            case RoomStatus.Finished:
                <DraftResult Room="_room" IsHost="_isHost" />
                break;

            default:
                <DraftBoard Room="_room" MyTeamId="_myTeamId" HostKey="HostKey" />
                break;
        }
    }
</div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    [SupplyParameterFromQuery(Name = "host")] private string? HostKey { get; set; }
    [SupplyParameterFromQuery(Name = "me")] private string? MeTeam { get; set; }
    [SupplyParameterFromQuery(Name = "role")] private string? Role { get; set; }

    private DraftRoom? _room;
    private DraftRoom? _subscribed;
    private bool _isHost;
    private Guid? _myTeamId;
    private bool _spectator;

    // 접속 집계용. 프리렌더에서 중복으로 세지 않도록 회선이 붙은 뒤에만 자리를 잡는다.
    private bool _interactive;
    private bool _seated;
    private DraftRoom? _seatedRoom;
    private Guid? _seatedTeam;

    // 진행자 권한 복구용.
    private string? _savedHostKey;
    private bool _guardDismissed;
    private bool _askingHostKey;
    private string _typedHostKey = "";
    private string? _hostKeyError;

    // 채팅용. 닉네임은 방마다 다시 정하기 번거로우니 브라우저에 기억해둔다.
    private bool _chatOpen;
    private string _name = "";
    private bool _editingName;
    private string _typedName = "";

    private string RoleLabel => _isHost
        ? "진행자"
        : _myTeamId is { } id && _room?.Teams.FirstOrDefault(t => t.Id == id) is { } team
            ? $"팀장 · {team.Name}"
            : "관전자";

    private string StatusLabel => _room?.Status switch
    {
        RoomStatus.Setup => "설정 중",
        RoomStatus.Running => "진행 중",
        RoomStatus.Paused => "일시정지",
        RoomStatus.Finished => "완료",
        _ => "",
    };

    private string StatusClass => _room?.Status switch
    {
        RoomStatus.Running => "live",
        RoomStatus.Paused => "warn",
        RoomStatus.Finished => "done",
        _ => "idle",
    };

    protected override void OnParametersSet()
    {
        _room = Store.Find(Code);

        if (!ReferenceEquals(_subscribed, _room))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnRoomChanged;
            _subscribed = _room;
            if (_subscribed is not null) _subscribed.Changed += OnRoomChanged;
        }

        _isHost = _room?.IsHost(HostKey) == true;
        _spectator = Role == "spec";

        // 팀이 지워졌을 수도 있으니 실제 존재하는 팀일 때만 팀장으로 인정한다.
        _myTeamId = Guid.TryParse(MeTeam, out var parsed) && _room?.Teams.Any(t => t.Id == parsed) == true
            ? parsed
            : null;

        SyncSeat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 프리렌더 단계에서는 세지 않는다. 실제 회선이 붙은 뒤부터가 진짜 접속이다.
        if (!firstRender) return;

        _interactive = true;
        SyncSeat();

        if (await Js<string?>("recallName") is { Length: > 0 } remembered)
        {
            _name = remembered;
            StateHasChanged();
        }

        if (_room is null) return;

        if (_isHost)
        {
            // 탭을 닫아도 돌아올 수 있게 이 브라우저에 남겨둔다.
            await Js("rememberHost", Code, _room.HostKey);
            return;
        }

        // 링크 없이 들어왔다면 예전에 저장해둔 키가 있는지 본다. 자동으로 진행자로
        // 바꾸지는 않는다 — 같은 브라우저를 팀장이 쓸 수도 있으므로 선택지로만 보여준다.
        var saved = await Js<string?>("recallHost", Code);
        if (string.IsNullOrEmpty(saved)) return;

        if (_room.IsHost(saved))
        {
            _savedHostKey = saved;
            StateHasChanged();
        }
        else
        {
            await Js("forgetHost", Code);
        }
    }

    /// <summary>이 화면이 앉아 있는 자리를 현재 역할에 맞춘다. 역할이 바뀌면 이전 자리에서 일어난다.</summary>
    private void SyncSeat()
    {
        if (!_interactive) return;

        var wanted = _myTeamId;
        if (_seated && _seatedRoom == _room && _seatedTeam == wanted) return;

        if (_seated) _seatedRoom?.LeaveSeat(_seatedTeam);

        _seatedRoom = _room;
        _seatedTeam = wanted;
        _seated = _room is not null;
        _room?.TakeSeat(wanted);
    }

    private void OnRoomChanged() => InvokeAsync(StateHasChanged);

    private void ChooseTeam(Guid teamId)
    {
        // 닉네임을 안 적었으면 팀장 이름을 빌려 쓴다.
        if (_name.Length == 0 && _room?.Teams.FirstOrDefault(t => t.Id == teamId)?.Captain is { Length: > 0 } captain)
        {
            _name = captain;
            _ = RememberName();
        }
        Nav.NavigateTo($"/room/{Code}?me={teamId}", replace: true);
    }

    private async Task RememberName()
    {
        var trimmed = _name.Trim();
        if (trimmed.Length > 0) await Js("rememberName", trimmed);
    }

    private void OpenNameEditor()
    {
        _typedName = _name;
        _editingName = true;
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = SaveName();
    }

    private async Task SaveName()
    {
        var trimmed = _typedName.Trim();
        if (trimmed.Length == 0) return;

        _name = trimmed;
        _editingName = false;
        _typedName = "";
        await RememberName();
    }

    private void ChooseSpectator() => Nav.NavigateTo($"/room/{Code}?role=spec", replace: true);

    private void ClearRole() => Nav.NavigateTo($"/room/{Code}", replace: true);

    private void OnHostKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") EnterAsHost(_typedHostKey);
    }

    private void EnterAsHost(string? key)
    {
        var trimmed = key?.Trim();
        if (_room?.IsHost(trimmed) != true)
        {
            _hostKeyError = "진행자 키가 맞지 않습니다.";
            return;
        }
        Nav.NavigateTo($"/room/{Code}?host={trimmed}", replace: true);
    }

    private string JoinLink() => Link($"room/{Code}");

    private string HostLink() => Link($"room/{Code}?host={_room?.HostKey}");

    private string Link(string relative) => new Uri(new Uri(Nav.BaseUri), relative).ToString();

    private async Task Js(string method, params object?[] args)
    {
        try { await JS.InvokeVoidAsync($"draftPick.{method}", args); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task<T?> Js<T>(string method, params object?[] args)
    {
        try { return await JS.InvokeAsync<T?>($"draftPick.{method}", args); }
        catch (JSException) { return default; }
        catch (JSDisconnectedException) { return default; }
    }

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnRoomChanged;
        if (_seated) _seatedRoom?.LeaveSeat(_seatedTeam);
    }
}
