@* 진행자 전용 설정 화면. 여기서 바꾼 값은 즉시 대기 중인 팀장 화면에도 반영된다. *@

<div class="setup">
    <div class="setup-col">
        <section class="card">
            <h2>드래프트 설정</h2>

            <label class="field">
                <span>제목</span>
                <input class="input" @bind="Room.Title" @bind:after="Notify" maxlength="40" />
            </label>

            <div class="field">
                <span>지명 순서</span>
                <div class="mode-choice">
                    @foreach (var mode in Enum.GetValues<DraftOrderMode>())
                    {
                        <button class="mode-btn tile @(Room.OrderMode == mode ? "on" : "")"
                                @onclick="() => SetMode(mode)">
                            <b>@mode.Label()</b>
                            <small>@mode.Pattern()</small>
                        </button>
                    }
                </div>
                <p class="hint">
                    @(Room.OrderMode == DraftOrderMode.Snake
                        ? "라운드마다 순서가 뒤집혀 뒷번호 팀장의 불리함이 줄어듭니다."
                        : "매 라운드 같은 순서로 지명합니다. 1픽 팀이 계속 유리합니다.")
                </p>
            </div>

            <div class="field-row">
                <label class="field">
                    <span>라운드 수 (팀당 인원)</span>
                    <input class="input" type="number" min="@DraftRoom.MinRounds" max="@DraftRoom.MaxRounds"
                           @bind="Room.Rounds" @bind:after="Notify" />
                </label>

                <label class="field">
                    <span>턴 제한시간 (초, 0=무제한)</span>
                    <input class="input" type="number" min="0" max="@DraftRoom.MaxTurnSeconds" step="5"
                           @bind="Room.TurnSeconds" @bind:after="Notify" />
                </label>
            </div>

            <label class="check">
                <input type="checkbox" @bind="Room.AutoPickOnTimeout" @bind:after="Notify" />
                <span>시간 초과 시 남은 선수 중 맨 위를 자동 지명</span>
            </label>
            <p class="hint">
                끄면 타이머가 0에서 멈추고 진행자가 대리 지명하거나 턴을 넘길 때까지 기다립니다.
            </p>
        </section>

        <section class="card">
            <div class="card-head">
                <h2>팀 <span class="count">@Room.Teams.Count</span></h2>
                <div class="row-actions">
                    <button class="btn btn-sm" @onclick="Room.ShuffleTeams" disabled="@(Room.Teams.Count < 2)">순서 섞기</button>
                    <button class="btn btn-sm" @onclick="() => Room.AddTeam()">+ 팀 추가</button>
                </div>
            </div>

            @if (Room.Teams.Count == 0)
            {
                <p class="muted">팀을 2개 이상 추가하세요.</p>
            }

            <div class="team-editor">
                @for (var index = 0; index < Room.Teams.Count; index++)
                {
                    var team = Room.Teams[index];
                    <div class="team-row" style="--team-color:@team.Color" @key="team.Id">
                        <span class="pick-order" title="@(index + 1)번 지명권">@(index + 1)</span>
                        <SeatLight Connected="Room.IsTeamConnected(team.Id)" />

                        <input class="input" placeholder="팀 이름"
                               @bind="team.Name" @bind:after="Notify" maxlength="20" />
                        <input class="input" placeholder="팀장 이름"
                               @bind="team.Captain" @bind:after="Notify" maxlength="20" />

                        <select class="input color-select" style="color:@team.Color"
                                @bind="team.Color" @bind:after="Notify">
                            @foreach (var color in TeamColors.Palette)
                            {
                                <option value="@color" style="color:@color">@color</option>
                            }
                        </select>

                        <div class="row-actions">
                            <button class="icon-btn" title="위로" disabled="@(index == 0)"
                                    @onclick="() => Room.MoveTeam(team.Id, -1)">↑</button>
                            <button class="icon-btn" title="아래로" disabled="@(index == Room.Teams.Count - 1)"
                                    @onclick="() => Room.MoveTeam(team.Id, 1)">↓</button>
                            <button class="icon-btn danger" title="삭제"
                                    @onclick="() => Room.RemoveTeam(team.Id)">✕</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="setup-col">
        <section class="card">
            <div class="card-head">
                <h2>선수 <span class="count">@Room.Players.Count</span></h2>
                <div class="row-actions">
                    <button class="btn btn-sm" @onclick="Room.SortPlayersByTier">티어순 정렬</button>
                    <button class="btn btn-sm danger" @onclick="ClearPlayers" disabled="@(Room.Players.Count == 0)">전체 삭제</button>
                </div>
            </div>

            <div class="quick-add">
                <input class="input" placeholder="선수 이름" maxlength="20" autocomplete="off"
                       @bind="_newName" @bind:event="oninput" @onkeydown="OnQuickAddKeyDown" />

                <select class="input" @bind="_newPosition">
                    @foreach (var pos in Positions.All)
                    {
                        <option value="@pos">@pos</option>
                    }
                </select>

                <select class="input" @bind="_newTier">
                    @foreach (var tier in Tiers.All)
                    {
                        <option value="@tier">@TierLabel(tier)</option>
                    }
                </select>

                <button class="btn btn-primary" @onclick="AddOne"
                        disabled="@(string.IsNullOrWhiteSpace(_newName))">추가</button>
            </div>
            <p class="hint">이름을 적고 Enter를 누르면 바로 추가됩니다. 포지션·티어는 다음 선수에도 그대로 남습니다.</p>

            <details class="bulk">
                <summary>여러 명 한 번에 붙여넣기</summary>
                <textarea class="input textarea" rows="5" placeholder="@BulkPlaceholder"
                          @bind="_bulk" @bind:event="oninput"></textarea>
                <div class="row-actions">
                    <button class="btn btn-primary btn-sm" @onclick="ImportBulk"
                            disabled="@(string.IsNullOrWhiteSpace(_bulk))">명단 추가</button>
                    <span class="hint">
                        한 줄에 한 명. <code>이름,포지션,티어</code> 순서이고 뒤 두 개는 생략해도 됩니다.
                        엑셀에서 그대로 복사해 붙여넣어도 됩니다(머리글 행은 알아서 건너뜁니다).
                    </span>
                </div>
            </details>

            @if (_importMessage is not null)
            {
                <p class="ok-text">@_importMessage</p>
            }

            @{
                var duplicates = Room.DuplicatePlayerNames();
            }
            @if (duplicates.Count > 0)
            {
                <p class="warn-text">이름이 겹치는 선수가 있습니다 — @string.Join(", ", duplicates)</p>
            }

            <div class="player-editor">
                @foreach (var player in Room.Players)
                {
                    <div class="player-row" @key="player.Id">
                        <input class="input" @bind="player.Name" @bind:after="Notify" maxlength="20" />

                        <select class="input" @bind="player.Position" @bind:after="Notify">
                            @foreach (var pos in Positions.All)
                            {
                                <option value="@pos">@pos</option>
                            }
                        </select>

                        <select class="input" @bind="player.Tier" @bind:after="Notify">
                            @foreach (var tier in Tiers.All)
                            {
                                <option value="@tier">@TierLabel(tier)</option>
                            }
                        </select>

                        <button class="icon-btn danger" title="삭제"
                                @onclick="() => Room.RemovePlayer(player.Id)">✕</button>
                    </div>
                }
            </div>
        </section>

        <section class="card start-card">
            @{
                // 락을 잡고 도는 검사라 렌더당 한 번만 부른다.
                var problem = Room.ValidateForStart();
            }
            <div class="start-summary">
                <div>
                    <span class="summary-num">@Room.Teams.Count</span>
                    <span class="summary-label">팀</span>
                </div>
                <span class="summary-x">×</span>
                <div>
                    <span class="summary-num">@Room.Rounds</span>
                    <span class="summary-label">라운드</span>
                </div>
                <span class="summary-x">=</span>
                <div>
                    <span class="summary-num @(Room.Players.Count >= Room.TotalPicks ? "ok" : "bad")">@Room.TotalPicks</span>
                    <span class="summary-label">필요 인원 (등록 @(Room.Players.Count)명)</span>
                </div>
            </div>

            <p class="seat-summary">
                <SeatLight Connected="Room.ConnectedTeamCount > 0" />
                팀장 접속 <b>@Room.ConnectedTeamCount</b> / @Room.Teams.Count
                @if (Room.Teams.Count > 0 && Room.ConnectedTeamCount < Room.Teams.Count)
                {
                    <span class="muted">— 방 코드 <b>@Room.Code</b> 를 알려주세요</span>
                }
            </p>

            @if (problem is not null)
            {
                <p class="error-text">@problem</p>
            }
            else
            {
                <p class="ok-text">준비 완료. 시작하면 대기 중인 팀장 화면이 바로 드래프트 보드로 바뀝니다.</p>
            }

            <button class="btn btn-primary btn-lg" @onclick="Start" disabled="@(problem is not null)">
                드래프트 시작
            </button>
            @if (_startError is not null)
            {
                <p class="error-text">@_startError</p>
            }
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required DraftRoom Room { get; set; }

    /// <summary>Razor 속성 안에서는 &amp;#10; 이 그대로 출력되므로 실제 줄바꿈 문자열을 넘긴다.</summary>
    private const string BulkPlaceholder = "홍길동,타격대,다이아\n김철수,감시자\n이영희";

    private string _bulk = "";
    private string? _importMessage;
    private string? _startError;

    // 한 명씩 추가할 때 쓰는 입력값. 포지션·티어는 연속 입력을 위해 초기화하지 않는다.
    private string _newName = "";
    private string _newPosition = Positions.Unset;
    private string _newTier = Tiers.Unset;

    private static string TierLabel(string tier) => tier == Tiers.Unset ? "티어 미지정" : tier;

    private void Notify() => Room.NotifyChanged();

    private void AddOne()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;

        Room.AddPlayer(_newName, _newPosition, _newTier);
        _newName = "";
        _importMessage = null;
    }

    private void OnQuickAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddOne();
    }

    private void SetMode(DraftOrderMode mode)
    {
        Room.OrderMode = mode;
        Notify();
    }

    private void ImportBulk()
    {
        var added = Room.ImportPlayers(_bulk);
        _importMessage = added > 0 ? $"{added}명 추가했습니다." : "추가된 선수가 없습니다.";
        if (added > 0) _bulk = "";
    }

    private void ClearPlayers()
    {
        Room.ClearPlayers();
        _importMessage = null;
    }

    private void Start() => _startError = Room.Start();
}
